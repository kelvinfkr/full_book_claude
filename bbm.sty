%% bbm.sty - Blackboard bold math symbols
%% Provides \mathbbm command for indicator functions etc.
%%
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{bbm}[2023/01/01 Blackboard bold symbols]

\RequirePackage{amsfonts}

% Define \mathbbm using amsfonts \mathbb as fallback
\DeclareRobustCommand{\mathbbm}[1]{%
  \ifmmode
    \mathbb{#1}%
  \else
    $\mathbb{#1}$%
  \fi
}

% Common shortcuts
\newcommand{\1}{\mathbbm{1}}  % Indicator function

\endinput
