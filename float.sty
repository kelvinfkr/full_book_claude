%% float.sty - Improved float handling
%% Minimal implementation
%%
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{float}[2023/01/01 Float improvements]

% New float definition
\newcommand{\newfloat}[4][]{%
  \@ifundefined{c@#2}{%
    \newcounter{#2}[#4]%
    \expandafter\renewcommand\csname the#2\endcsname{\arabic{#4}.\arabic{#2}}%
  }{}%
  \@namedef{#2}{\@float{#2}}%
  \@namedef{end#2}{\end@float}%
}

\newcommand{\floatname}[2]{%
  \@namedef{fname@#1}{#2}%
}

\newcommand{\floatstyle}[1]{}

\newcommand{\listof}[2]{%
  \section*{#2}%
}

\newcommand{\restylefloat}[1]{}

% H placement
\newcommand{\float@HKey}{H}

\endinput
