%% xcolor.sty - Extended colors
%% Minimal implementation
%%
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{xcolor}[2023/01/01 Extended colors]

\RequirePackage{color}

% Options
\DeclareOption*{}
\ProcessOptions\relax

% definecolor with model
\renewcommand{\definecolor}[3]{%
  \expandafter\def\csname color@#1\endcsname{#3}%
}

% colorlet
\newcommand{\colorlet}[2]{%
  \definecolor{#1}{named}{#2}%
}

% textcolor
\providecommand{\textcolor}[2]{{\color{#1}#2}}

% colorbox
\providecommand{\colorbox}[2]{\fbox{#2}}

% fcolorbox
\providecommand{\fcolorbox}[3]{\fbox{#3}}

% rowcolors (for tables)
\newcommand{\rowcolors}[3]{}

% Common colors
\definecolor{red}{rgb}{1,0,0}
\definecolor{green}{rgb}{0,1,0}
\definecolor{blue}{rgb}{0,0,1}
\definecolor{cyan}{rgb}{0,1,1}
\definecolor{magenta}{rgb}{1,0,1}
\definecolor{yellow}{rgb}{1,1,0}
\definecolor{black}{rgb}{0,0,0}
\definecolor{white}{rgb}{1,1,1}
\definecolor{gray}{rgb}{0.5,0.5,0.5}
\definecolor{lightgray}{rgb}{0.75,0.75,0.75}
\definecolor{darkgray}{rgb}{0.25,0.25,0.25}
\definecolor{orange}{rgb}{1,0.5,0}
\definecolor{violet}{rgb}{0.5,0,0.5}
\definecolor{purple}{rgb}{0.5,0,0.5}
\definecolor{brown}{rgb}{0.6,0.3,0}

\endinput
