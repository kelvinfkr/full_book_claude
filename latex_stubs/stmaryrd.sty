%% stmaryrd.sty - St Mary Road symbols
%% Provides additional math symbols like double brackets
%%
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{stmaryrd}[2023/01/01 St Mary Road symbols]

\RequirePackage{amssymb}

% Double brackets (semantic brackets)
\DeclareMathDelimiter{\llbracket}{\mathopen}{AMSa}{"4A}{AMSa}{"4A}
\DeclareMathDelimiter{\rrbracket}{\mathclose}{AMSa}{"4B}{AMSa}{"4B}

% Fallback definitions using standard brackets if above fails
\providecommand{\llbracket}{[\![}
\providecommand{\rrbracket}{]\!]}

% Lightning bolt (contradiction)
\providecommand{\lightning}{\text{\Lightning}}

% Short arrows
\providecommand{\shortrightarrow}{\rightarrow}
\providecommand{\shortleftarrow}{\leftarrow}

% Merge and split
\providecommand{\merge}{\wedge}
\providecommand{\split}{\vee}

% Big operators
\providecommand{\bigcurlywedge}{\bigwedge}
\providecommand{\bigcurlyvee}{\bigvee}

\endinput
