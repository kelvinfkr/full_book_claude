%% tcolorbox.sty - Colored boxes
%% Minimal implementation for compatibility
%%
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{tcolorbox}[2023/01/01 Colored boxes]

\RequirePackage{xcolor}
\RequirePackage{framed}

% Process options
\newif\iftcb@skins
\newif\iftcb@breakable
\DeclareOption{skins}{\tcb@skinstrue}
\DeclareOption{breakable}{\tcb@breakabletrue}
\DeclareOption{most}{\tcb@skinstrue\tcb@breakabletrue}
\ProcessOptions\relax

% Default colors
\definecolor{tcbcolback}{RGB}{240,248,255}
\definecolor{tcbcolframe}{RGB}{70,130,180}

% tcolorbox environment
\newenvironment{tcolorbox}[1][]{%
  \def\tcb@title{}%
  \tcb@parseoptions{#1}%
  \begin{framed}%
  \noindent%
  \ifx\tcb@title\empty\else%
    {\bfseries\tcb@title}\par\smallskip%
  \fi%
}{%
  \end{framed}%
}

% Parse options (simplified)
\newcommand{\tcb@parseoptions}[1]{%
  \@for\tcb@opt:=#1\do{%
    \expandafter\tcb@parseopt\tcb@opt\@nil%
  }%
}

\def\tcb@parseopt#1=#2\@nil{%
  \ifx#1title%
    \def\tcb@title{#2}%
  \fi%
}

% Simpler option parsing - just extract title
\renewcommand{\tcb@parseoptions}[1]{%
  \def\tcb@title{}%
  \@temptokena={#1}%
  \expandafter\tcb@findtitle\the\@temptokena title=\@nil%
}

\def\tcb@findtitle#1title=#2\@nil{%
  \ifx\relax#2\relax\else%
    \tcb@extracttitle#2\@nil%
  \fi%
}

\def\tcb@extracttitle#1,#2\@nil{\def\tcb@title{#1}}
\def\tcb@extracttitle#1\@nil{\def\tcb@title{#1}}

% newtcolorbox command
\newcommand{\newtcolorbox}[3][]{%
  \newenvironment{#2}{%
    \begin{tcolorbox}[#3,#1]%
  }{%
    \end{tcolorbox}%
  }%
}

% tcbset
\newcommand{\tcbset}[1]{}

% tcblisting (stub)
\newenvironment{tcblisting}[1][]{%
  \begin{tcolorbox}[#1]%
  \ttfamily%
}{%
  \end{tcolorbox}%
}

\endinput
