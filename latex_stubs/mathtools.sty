%% mathtools.sty - Math tools extension
%% Minimal implementation
%%
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{mathtools}[2023/01/01 Math tools]

\RequirePackage{amsmath}

% Paired delimiters
\newcommand{\DeclarePairedDelimiter}[3]{%
  \expandafter\newcommand\csname #1\endcsname[1]{%
    \mathopen{}\left#2##1\right#3\mathclose{}%
  }%
}

% Common paired delimiters
\DeclarePairedDelimiter{\abs}{\lvert}{\rvert}
\DeclarePairedDelimiter{\norm}{\lVert}{\rVert}
\DeclarePairedDelimiter{\ceil}{\lceil}{\rceil}
\DeclarePairedDelimiter{\floor}{\lfloor}{\rfloor}

% Coloneqq
\providecommand{\coloneqq}{\mathrel{:=}}
\providecommand{\eqqcolon}{\mathrel{=:}}

% dcases environment
\newenvironment{dcases}{%
  \left\lbrace\begin{array}{@{}l@{\quad}l@{}}%
}{%
  \end{array}\right.%
}

% Shortintertext
\newcommand{\shortintertext}[1]{\intertext{#1}}

% Prescript (for isotopes etc)
\newcommand{\prescript}[3]{{}^{#1}_{#2}#3}

\endinput
