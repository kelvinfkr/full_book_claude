%% sidenotes.sty - Sidenotes and margin notes
%% Minimal implementation for compatibility
%%
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{sidenotes}[2023/01/01 Sidenotes]

\RequirePackage{marginnote}

% Sidenote command
\newcommand{\sidenote}[2][]{%
  \marginnote{#2}%
}

% Side figure environment
\newenvironment{sidefigure}[1][htbp]{%
  \begin{figure}[#1]%
}{%
  \end{figure}%
}

% Side table environment
\newenvironment{sidetable}[1][htbp]{%
  \begin{table}[#1]%
}{%
  \end{table}%
}

% Side caption
\newcommand{\sidecaption}[2][]{%
  \caption{#2}%
}

\endinput
