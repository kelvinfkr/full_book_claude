%% algpseudocode.sty - Algorithmic pseudocode
%% Minimal implementation for compatibility
%%
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{algpseudocode}[2023/01/01 Algorithmic pseudocode]

% Basic algorithmic environment
\newenvironment{algorithmic}[1][]{%
  \par\noindent
  \begin{list}{}{%
    \setlength{\leftmargin}{2em}%
    \setlength{\itemsep}{0pt}%
    \setlength{\parsep}{0pt}%
  }%
}{%
  \end{list}%
}

% Keywords
\newcommand{\State}{\item}
\newcommand{\Require}{\item\textbf{输入: }}
\newcommand{\Ensure}{\item\textbf{输出: }}
\newcommand{\If}[1]{\item\textbf{if} #1 \textbf{then}}
\newcommand{\ElsIf}[1]{\item\textbf{else if} #1 \textbf{then}}
\newcommand{\Else}{\item\textbf{else}}
\newcommand{\EndIf}{\item\textbf{end if}}
\newcommand{\For}[1]{\item\textbf{for} #1 \textbf{do}}
\newcommand{\ForAll}[1]{\item\textbf{for all} #1 \textbf{do}}
\newcommand{\EndFor}{\item\textbf{end for}}
\newcommand{\While}[1]{\item\textbf{while} #1 \textbf{do}}
\newcommand{\EndWhile}{\item\textbf{end while}}
\newcommand{\Repeat}{\item\textbf{repeat}}
\newcommand{\Until}[1]{\item\textbf{until} #1}
\newcommand{\Loop}{\item\textbf{loop}}
\newcommand{\EndLoop}{\item\textbf{end loop}}
\newcommand{\Function}[2]{\item\textbf{function} \textsc{#1}(#2)}
\newcommand{\EndFunction}{\item\textbf{end function}}
\newcommand{\Procedure}[2]{\item\textbf{procedure} \textsc{#1}(#2)}
\newcommand{\EndProcedure}{\item\textbf{end procedure}}
\newcommand{\Return}[1]{\item\textbf{return} #1}
\newcommand{\Call}[2]{\textsc{#1}(#2)}
\newcommand{\Comment}[1]{\hfill$\triangleright$ #1}

\endinput
