%% framed.sty - Framed environments
%% Minimal implementation
%%
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{framed}[2023/01/01 Framed]

\RequirePackage{xcolor}

% framed environment
\newenvironment{framed}{%
  \begin{center}%
  \begin{tabular}{|p{0.9\linewidth}|}%
  \hline%
}{%
  \\\hline%
  \end{tabular}%
  \end{center}%
}

% shaded environment
\newenvironment{shaded}{%
  \begin{framed}%
}{%
  \end{framed}%
}

% leftbar environment
\newenvironment{leftbar}{%
  \begin{framed}%
}{%
  \end{framed}%
}

% Colors
\definecolor{shadecolor}{rgb}{0.95,0.95,0.95}

\endinput
